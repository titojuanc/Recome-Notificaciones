# Conexión a RabbitMQ
# En Dokploy: usuario `notificaciones-worker` y el vhost del entorno al final de la URL
# (provision.sh crea el vhost `dev` y deja a `guest` sin acceso). Ej:
#   amqp://notificaciones-worker:<clave>@<host-del-broker>:5672/dev
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_NOTIFICACIONES=notificaciones
RABBITMQ_PREFETCH_COUNT=10

# Límite de reintentos y TTL de la cola (evita que un mensaje viva o se
# reintente indefinidamente y termine colapsando el sistema). Al agotar
# cualquiera de los dos, el mensaje se manda a la dead-letter exchange.
RABBITMQ_DELIVERY_LIMIT=5
RABBITMQ_MESSAGE_TTL_MS=86400000

# Deduplicación (SQLite embebido, propio del worker)
# En Dokploy, montar un VOLUMEN en /app/data: dev se redespliega en cada push y sin
# volumen la base se pierde, con lo que un mensaje reentregado se enviaría dos veces.
SQLITE_DEDUP_PATH=data/processed_messages.db

# Canal mail (Mailpit en desarrollo/tests; SMTP real en producción)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=notificaciones@recome.local
# SMTP autenticado. Para enviar mails REALES con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls   (o SMTP_PORT=465 y ssl)
#   SMTP_USER=<cuenta>@gmail.com  SMTP_FROM=<la misma cuenta>
#   SMTP_PASSWORD=<contraseña de aplicación de 16 caracteres>: requiere verificación en dos pasos;
#   se crea en https://myaccount.google.com/apppasswords. La contraseña normal NO funciona.
# Gmail limita a ~500 mails/día (cuenta personal). Nunca commitear la contraseña real.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=5

# Canal push (Web Push / VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_SUB=mailto:admin@recome.local

# Callback de confirmación hacia recome-api-general (Spec 4): tras enviar un
# mail con éxito, si el mensaje trae "callback_url", se hace POST a esa URL.
# Se autentica con el header X-Service-Api-Key. El valor es el MISMO secreto que
# recommendations.service-api-key.current de recome-api-general (el mismo que usa
# API_GENERAL_API_KEY en Recome-Recos-Auto, pero allí va en otro header:
# X-Internal-API-Key). Para este callback api-general no exige el prefijo de
# entorno; usar igualmente el valor completo <entorno>.<secreto>.
# El secreto real se entrega por el gestor de secretos, no se commitea.
RECOMMENDATIONS_SERVICE_API_KEY=cambiar-por-la-clave-real
CALLBACK_TIMEOUT_SECONDS=5
